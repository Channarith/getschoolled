# Copy to config/lab.env (gitignored) for local lab runs.

# xAI Grok voice agent (server-side — never ship to browsers without ephemeral tokens)
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE_NAME=ara

# AOEP service endpoints (integration harness)
ORCHESTRATOR_URL=http://localhost:8000
PERCEPTION_URL=http://localhost:8003
IDENTITY_URL=http://localhost:8008

# Default scenario mode: solo | group | self_teach
WEBCAM_LAB_MODE=solo
