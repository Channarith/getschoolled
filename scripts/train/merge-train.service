# systemd user unit for a Linux host (alternative to launchd). Install:
#   mkdir -p ~/.config/systemd/user
#   sed "s#__REPO__#$PWD#g" scripts/train/merge-train.service > ~/.config/systemd/user/merge-train.service
#   cp scripts/train/merge-train.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now merge-train.timer
# The unit is a DRY RUN until Environment=TRAIN_APPLY=1 is set.
[Unit]
Description=Salareen merge train (one pass)

[Service]
Type=oneshot
WorkingDirectory=__REPO__
Environment=TRAIN_APPLY=0
Environment=TRAIN_WINDOW=08-23
ExecStart=/bin/bash __REPO__/scripts/train/run_train.sh
TimeoutStartSec=3600
KillMode=control-group
MemoryMax=2G
CPUQuota=200%
Nice=10
