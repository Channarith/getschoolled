# User slice that caps everything started inside it. Installed by scripts/fleet/install-units.sh
# with this machine's limits from budgets.conf. Needs cgroup v2 controller delegation to the user
# manager (default on Ubuntu 24.04 and DGX OS): check with
#   cat /sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers
[Unit]
Description=Salareen batch work (training, translation, TTS), capped so the machine stays usable

[Slice]
MemoryMax=@MEM_MAX@
MemoryHigh=@MEM_HIGH@
CPUQuota=@CPU_QUOTA@
TasksMax=@TASKS_MAX@
IOWeight=@IO_WEIGHT@
