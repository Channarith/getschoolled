# One file per job instance: ~/.config/gs/<job-name>.env, used by gs-job@<job-name>.service.
# GS_ARGS go to scripts/gs_run.sh, GS_CMD is the command (no shell quoting tricks: keep it simple,
# put anything complicated in a script and call that script).
GS_ARGS=--timeout 21600 --min-free-gb 8
GS_CMD=scripts/translate_on_machine.sh run ibuy
