# Template for a recurring or long job: one instance per job name.
#   cp ~/.config/gs/example.env ~/.config/gs/nllb-kalel.env   (edit GS_ARGS and GS_CMD)
#   systemctl --user start gs-job@nllb-kalel
# The job goes through gs_run.sh (memory floor, GPU lock, per-job limits, whole-tree cleanup) and
# sits inside gs-batch.slice, so the slice caps all jobs together as well.
#
# Restart policy: at most 3 starts per hour, 5 minutes apart. Exit 75 (not enough free memory, or
# the GPU lock is busy) and 64 (bad usage) are NOT retried by restart: start the unit again from a
# timer or by hand once the machine is free. This cannot turn into a restart storm.
#
# WatchdogSec is deliberately not set: it only works for Type=notify services that send keep-alive
# pings, and batch scripts do not. Use gs-fleet-check.timer plus --timeout in GS_ARGS instead.
[Unit]
Description=Salareen batch job %i
Documentation=file://@REPO@/docs/fleet-ops.txt
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
Slice=gs-batch.slice
WorkingDirectory=@REPO@
EnvironmentFile=%h/.config/gs/%i.env
ExecStart=/bin/bash -c 'exec "@REPO@/scripts/gs_run.sh" --name "%i" $GS_ARGS -- $GS_CMD'
KillMode=control-group
TimeoutStopSec=60
SendSIGKILL=yes
Restart=on-failure
RestartSec=300
RestartPreventExitStatus=75 64
Nice=10
