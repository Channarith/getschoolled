[Unit]
Description=AOEP voice listening lab on 127.0.0.1:8790
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=-%h/.config/aoep/spark-units.env
ExecStart=@ROOT@/scripts/fleet/spark-units/listening-lab.sh
MemoryMax=2G
MemorySwapMax=0
Nice=5
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=append:%h/.local/share/aoep-train/listening-lab.log
StandardError=append:%h/.local/share/aoep-train/listening-lab.log

[Install]
WantedBy=default.target
