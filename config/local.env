# Local deployment contract (docker compose / single machine).
# The SAME code reads these; switch to config/cloud.env for cloud.

DEPLOY_MODE=local

# Per-component overrides (leave blank to inherit DEPLOY_MODE).
LLM_MODE=
SPEECH_MODE=
VISION_MODE=
MEDIA_MODE=
OBJECT_STORE_MODE=
PAYMENT_MODE=

# Endpoints (compose service names).
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=education-base
# Bearer token for the OpenAI-compatible LLM endpoint (leave blank for local vLLM).
LLM_API_KEY=
# Track B per-domain routing (category=model,...) for RoutedLLMProvider. Empty = single model.
LLM_ROUTES=
# NVIDIA Nemotron conversational agent (real-time, streaming). Set NEMOTRON_API_KEY
# to route the tutor + voice assistant through Nemotron via NVIDIA NIM (or set
# NEMOTRON_BASE_URL to a self-hosted vLLM serving a Nemotron model). LLM_PROVIDER=
# nemotron also forces it. Streaming (SSE /ask/stream) gives low-latency answers.
LLM_PROVIDER=
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# 24/7 harvester (runs on a separate worker agent)
HARVEST_USER_AGENT="AOEP-Harvester/1.0 (+contact@example.org)"
HARVEST_MAX_RPS=1.0
HARVEST_SEEDS=
# LiveKit (Salareen live-room WebRTC). LIVEKIT_URL is the compose service name;
# native dev (scripts/dev_up.sh, make run-orchestrator) rewrites it to
# ws://localhost:7880. LIVEKIT_API_KEY/SECRET MUST match the LiveKit server's
# `keys:` (the livekit service in infra/compose and infra/k8s/livekit.yaml) —
# mismatched keys make the server reject minted tokens with 401 so video never
# connects. `make run-livekit` starts a matching server for native dev.
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Memory service (per-student mastery/behavior signals for the live teaching
# loop). Blank => orchestrator runs with neutral signals (offline single-service
# demo). Compose service name is `memory`; native dev uses :8004.
MEMORY_URL=http://memory:8000
DATABASE_URL=postgresql://edu:edu@postgres:5432/edu
REDIS_URL=redis://redis:6379/0
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=edu-media

# Curriculum source for the RAG skeleton.
CURRICULUM_DIR=/app/sample-curriculum

# Web -> orchestrator (browser-visible).
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8000

# Catalog + corrections persistence (blank => in-memory).
CATALOG_PATH=
CORRECTIONS_JSONL=training/data/corrections.jsonl

# Seed the default corporate training programs on startup so the /corporate
# funnel is populated out of the box. Disable with SEED_CORPORATE_PROGRAMS=0.
SEED_CORPORATE_PROGRAMS=1

# Course-validation search engine keys (blank => offline mock engine).
BING_SEARCH_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_KEY=
KAGI_API_KEY=
BAIDU_API_KEY=
# Bake-off champion pointer (written by training/bakeoff.py --champion-path)
CHAMPION_PATH=
# Content-credentials/provenance signing key (Trust layer)
PROVENANCE_SIGNING_KEY=
# OCR (homework scanning; handwriting needs a cloud OCR backend)
OCR_MODE=
OCR_API_KEY=
OCR_ENDPOINT=
# Neural TTS: ElevenLabs for the most natural, cultural narration voices (Drive
# Mode + live class). Set the key to enable; the speech gateway falls back to
# edge-tts neural, then the browser/device voice, when unset. Optional per-style
# voice overrides: ELEVENLABS_VOICE_ID (global) or ELEVENLABS_VOICE_<STYLE>.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# CosyVoice 2 (self-hosted, FunAudioLLM): point COSYVOICE_URL at your inference
# server to make it the preferred narration engine (Drive Mode + live class, web
# + mobile). The gateway POSTs {COSYVOICE_URL}{COSYVOICE_PATH} (default /tts) with
# {text,language,speaker,instruct,mode,sample_rate} and expects audio bytes back.
# Optional: COSYVOICE_API_KEY (bearer), COSYVOICE_PATH, COSYVOICE_MODE
# (instruct2|zero_shot|cross_lingual). Falls back to ElevenLabs/edge-tts if unset.
COSYVOICE_URL=
COSYVOICE_API_KEY=
# Human-in-the-loop autonomy: autonomous | suggest | human_led
HIL_AUTONOMY=autonomous
# Embodiment: screen | robot (humanoid)
EMBODIMENT=screen
ROBOT_ENDPOINT=
# Integrations: webhook signing + inbound verification
WEBHOOK_SIGNING_KEY=
# Compliance region for the policy engine: us | us_il | eu | other
REGION=us
# Careers / jobs source. Off by default locally (serves the curated sample board
# offline, no network). Set JOBS_LIVE=1 to pull real openings from public boards
# (Remotive + Arbeitnow), or RAPIDAPI_KEY (JSearch: LinkedIn/Indeed/Glassdoor) /
# ADZUNA_APP_ID+ADZUNA_APP_KEY for keyed aggregators. Falls back to sample if
# the network is unavailable. JOBS_PROVIDER can pin one (remotive|arbeitnow|
# jsearch|adzuna|linkedin|sample|live).
JOBS_LIVE=
JOBS_PROVIDER=
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Identity: session-token signing key (set a strong secret in production)
AUTH_SIGNING_KEY=
# OAuth providers for social sign-in. Local mode accepts sandbox_* tokens even
# when these are blank; set these to test real Google/Facebook tokens.
GOOGLE_CLIENT_ID=647091395717-scfbmvsudec5t9vqukk2h8k732bgd3kp.apps.googleusercontent.com
FACEBOOK_APP_ID=1071803295271778
FACEBOOK_APP_SECRET=89dee9dcf861eb13eeed40059634bbc7
APPLE_BUNDLE_ID=com.aiclassroom.app
APPLE_TEAM_ID=T4738P393L
# Default admin account, seeded at identity startup so you can log in out of the
# box. Log in with the email OR the bare username. CHANGE the password for any
# real deployment. Disable seeding with SEED_DEFAULT_ADMIN=0.
SEED_DEFAULT_ADMIN=1
DEFAULT_ADMIN_EMAIL=admin@salareen.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=88888888
# QA test accounts (3 personas for manual/release testing). Log in with email or
# qa1 / qa2 / qa3. Disable seeding with SEED_QA_ACCOUNTS=0.
SEED_QA_ACCOUNTS=1
QA_ACCOUNTS_PASSWORD=QaTest123
# Admin: secret that gates administrative feature-flag writes (X-Admin-Secret
# header). Defaults to a dev value when unset; set a strong secret in production.
ADMIN_SECRET=
# Optional GitHub mirroring. Full evidence goes private; public issues contain
# metadata only. Reports still persist locally when these are blank/failing.
BUG_REPORT_GITHUB_PRIVATE_REPO=
BUG_REPORT_GITHUB_PUBLIC_REPO=
BUG_REPORT_GITHUB_TOKEN=
# Durable default for engagement.in_app_bug_reporter (admin Feature Flags can
# still override at runtime). Set 0 in production when the QA button is retired.
IN_APP_BUG_REPORTER_ENABLED=1
# Automation/E2E test hooks (deterministic reset/seed). Implicitly on for local/
# edge, off for cloud; set to 1/0 to force. Always also requires the admin secret.
ENABLE_TEST_ENDPOINTS=
# Observability: every service exposes /metrics (Prometheus) + /telemetry/* with
# zero deps. Optional external export (only used if the lib is installed):
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
