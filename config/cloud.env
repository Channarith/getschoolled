# Cloud deployment contract (Kubernetes + GPU pool).
# Same code as local; only this env differs. Secrets are injected by the
# platform (never committed): LLM/STRIPE/LIVEKIT/DB credentials, etc.

DEPLOY_MODE=cloud

# Compliance lever example: keep biometrics local even in cloud.
# VISION_MODE=local
LLM_MODE=
SPEECH_MODE=
VISION_MODE=
MEDIA_MODE=
OBJECT_STORE_MODE=
PAYMENT_MODE=

LLM_BASE_URL=https://llm.internal/v1
LLM_MODEL=education-base
LLM_API_KEY=
# Track B per-domain routing (category=model,...) for RoutedLLMProvider. Empty = single model.
LLM_ROUTES=
# NVIDIA Nemotron conversational agent (streaming, real-time). Set NEMOTRON_API_KEY
# (NVIDIA NIM) or NEMOTRON_BASE_URL (self-hosted vLLM). LLM_PROVIDER=nemotron forces it.
LLM_PROVIDER=
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# 24/7 harvester (runs on a separate worker agent)
HARVEST_USER_AGENT=AOEP-Harvester/1.0 (+contact@example.org)
HARVEST_MAX_RPS=2.0
HARVEST_SEEDS=
# LiveKit signaling URL (wss). On VKE this is wss://livekit.salareen.com.
# LIVEKIT_API_KEY/SECRET are NOT committed — they are injected as secrets and
# MUST match the LiveKit server's `keys:` (infra/k8s/livekit.yaml has
# devkey: devsecret for smoke tests; rotate to real secrets in production, and
# update both sides together or the server returns 401 on every token).
LIVEKIT_URL=wss://livekit.example.com
# Memory service (per-student mastery/behavior signals for the live teaching loop).
MEMORY_URL=http://memory:8000
DATABASE_URL=postgresql://edu:CHANGE_ME@db.internal:5432/edu
REDIS_URL=redis://redis.internal:6379/0
# LIVE_ROOM_BACKEND=memory and GROUP_CLASS_BACKEND=memory force per-pod stores (tests).
# When REDIS_URL is set on Vultr VKE, live rooms and group classes share Redis
# across orchestrator replicas automatically.
OBJECT_STORE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORE_BUCKET=edu-media-prod

CURRICULUM_DIR=/app/sample-curriculum
NEXT_PUBLIC_ORCHESTRATOR_URL=https://api.example.com

# Catalog + corrections persistence (object store / mounted path in cloud).
CATALOG_PATH=
CORRECTIONS_JSONL=

# Seed the default corporate training programs on startup so the /corporate
# funnel is populated out of the box. Disable with SEED_CORPORATE_PROGRAMS=0.
SEED_CORPORATE_PROGRAMS=1

# Course-validation search engine keys (injected as secrets in cloud).
BING_SEARCH_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_KEY=
KAGI_API_KEY=
BAIDU_API_KEY=
# Bake-off champion pointer (written by training/bakeoff.py --champion-path)
CHAMPION_PATH=
# Content-credentials/provenance signing key (Trust layer)
PROVENANCE_SIGNING_KEY=
# OCR (homework scanning; handwriting needs a cloud OCR backend)
OCR_MODE=
OCR_API_KEY=
OCR_ENDPOINT=
# Neural TTS: ElevenLabs for natural, cultural narration voices. Set the key
# (store as a real secret) to enable; falls back to edge-tts then device voice.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# CosyVoice 2 (self-hosted): set COSYVOICE_URL to your inference server to prefer
# it for narration (web + mobile). Optional COSYVOICE_API_KEY / COSYVOICE_PATH /
# COSYVOICE_MODE. Unset -> ElevenLabs/edge-tts as before.
COSYVOICE_URL=
COSYVOICE_API_KEY=
# Human-in-the-loop autonomy: autonomous | suggest | human_led
HIL_AUTONOMY=autonomous
# Embodiment: screen | robot (humanoid)
EMBODIMENT=screen
ROBOT_ENDPOINT=
# Integrations: webhook signing + inbound verification
WEBHOOK_SIGNING_KEY=
# Compliance region for the policy engine: us | us_il | eu | other
REGION=us
# Careers / jobs: pull REAL openings from public job boards (Remotive + Arbeitnow;
# no key, falls back to the curated board if egress is blocked). For listings that
# index LinkedIn/Indeed/Glassdoor, set RAPIDAPI_KEY (JSearch) or ADZUNA_APP_ID +
# ADZUNA_APP_KEY and they take precedence. JOBS_PROVIDER can pin one explicitly.
JOBS_LIVE=1
JOBS_PROVIDER=
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Identity: session-token signing key (set a strong secret in production)
AUTH_SIGNING_KEY=
# Default admin account seeded at identity startup (log in with the email OR the
# bare username). SECURITY: change DEFAULT_ADMIN_PASSWORD before exposing the
# service publicly, or set SEED_DEFAULT_ADMIN=0 and create the admin manually.
SEED_DEFAULT_ADMIN=1
DEFAULT_ADMIN_EMAIL=admin@salareen.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=88888888
# QA test accounts for manual/release testing (see docs/release-testing.txt).
SEED_QA_ACCOUNTS=1
QA_ACCOUNTS_PASSWORD=QaTest123
# Admin: secret that gates administrative feature-flag writes (X-Admin-Secret header)
ADMIN_SECRET=
# Automation/E2E test hooks: keep OFF in cloud unless a test run explicitly opts in.
ENABLE_TEST_ENDPOINTS=0
# Observability: /metrics (Prometheus) + /telemetry/* are always on. In cloud,
# point Prometheus at each service's /metrics; optionally export errors/traces:
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

# Ads — web display (AdSense via billing /ads/slot) + web video (VAST/VMAP on
# /watch, /class, Drive Mode) + mobile AdMob (banner + interstitial, iOS+Android).
# Free/basic tiers see ads; pro/premium/VIP (and admin) are ad-free. Impression/
# click beacons feed billing /ads/revenue (admin console -> "Ad Revenue"); real
# payout is the network's own dashboard. Use Google TEST IDs in staging:
#   AD_NETWORK=google_adsense
#   ADSENSE_CLIENT=ca-pub-3940256099942544
#   ADSENSE_SLOT_HOME_BANNER=6300978111
#   ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
#   ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
#   ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-3940256099942544/1033173712
#   ADMOB_INTERSTITIAL_IOS=ca-app-pub-3940256099942544/4411468910
# To see ads on any account (even VIP/admin) for testing, append ?ads=1 to the
# web URL, or sign in as a Standard-tier account (e.g. qa1/qa2).
AD_NETWORK=house
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME_BANNER=
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
ADMOB_INTERSTITIAL_ANDROID=
ADMOB_INTERSTITIAL_IOS=
