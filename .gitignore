# ---- Environment / secrets ----
# config/local.env and config/cloud.env are intentionally NOT committed.
# Copy config/local.env.example to config/local.env and fill in your values.
# Production secrets are injected via Kubernetes aoep-secrets (kubectl patch secret).
.env
.env.*
config/local.env
config/cloud.env

# ---- Kubeconfigs / cluster credentials (NEVER commit) ----
*kubeconfig*.yaml
*kubeconfig*.yml
kubeconfig-vke.yaml
salareen-kubeconfig*.yaml

# Local dev-launcher runtime (scripts/dev_up.sh)
logs/
*.local

# ---- Models / large artifacts (kept OUT of the repo) ----
models/weights/
models/cache/
*.safetensors
*.bin
*.gguf
*.onnx
*.pt
*.pth
*.ckpt

# ---- Generated output (harvest, exports, local runs) ----
output/

# ---- Data stores / volumes ----
infra/compose/data/
*.sqlite
*.db

# ---- Object store / media ----
minio-data/
recordings/

# ---- Auto-generated build manifest (regenerated by scripts/build_release.py /
#      bump_pr_version.py on every bump/build; nothing reads it at runtime -
#      /version uses the VERSION file + AOEP_* env). Tracking it made every PR
#      rewrite the version/sha/time lines, so it hard-conflicted on GitHub's
#      server-side merge (which ignores .gitattributes merge drivers). Untracked
#      = it can never conflict; regenerate locally with
#      `python3 scripts/build_release.py --refresh-only`. ----
build-info.txt

# ---- Build / OS / editor ----
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
coverage/

# ---- Root design assets (not source) ----
/Generated_image*.png

# ---- Local-only (never commit/push) ----
/local/
/CLAUDE.md
.gstack/

# ---- Music lab machine-translation cache (regenerates itself) ----
subrepos/theodore_music_lab/data/i18n_cache/

# ---- Playwright E2E artifacts ----
apps/web/e2e/.auth/
apps/web/e2e/.media/
apps/web/playwright-report/
apps/web/test-results/
docs/diagrams/overview-screens/
docs/diagrams/fundraising-screens/

# ---- Local avatar render scratch dir (render_avatar.mjs default output) ----
subrepos/theodore_course_studio/avatar/preview/
# ---- Test-generated host uploads (curriculum tests write here) ----
sample-curriculum/host-uploads/

# ---- CosyVoice URL expansion dumps (regenerate via cosyvoice_expand_channels.py) ----
urls/cosyvoice_*/ 
urls/cosyvoice_*_all.txt
urls/cosyvoice_expand_report.json
# keep urls/cosyvoice_channels.json, urls/cosyvoice_*_INDEX.txt, urls/cosyvoice_CORPUS_STATUS.txt
urls_km_*.txt
list_models.py

# Local npm/pnpm cache dumped by nvm/apt workflows into a staging dir.
# Never commit cache blobs - CI reinstalls from the lockfile anyway.
.tmp-stack/
# Scratch images saved into apps/web root during mascot iteration.
# Real referenced images live under apps/web/public/, not the app root.
apps/web/*.png
apps/web/*.jpeg
apps/web/*.jpg
apps/web/*.webp

# ---- Web public downloads (large installer artifacts, staged at build time) ----
# apps/web/public/downloads/README.txt is tracked; everything else is staged by
# ./scripts/stage_apk_for_web.sh before `docker build apps/web`.
apps/web/public/downloads/*.apk
apps/web/public/downloads/*.aab
apps/web/public/downloads/*.ipa
apps/web/public/downloads/*.dmg
apps/web/public/downloads/*.exe
apps/web/public/downloads/*.msi
apps/web/public/downloads/*.AppImage
apps/web/public/downloads/latest.json

# translations still being written
data/course_translations/**/*.partial.json
data/course_translations/**/*.partial

# raw data copied from other machines (iBuyPower, Spark): local only until validated
# (scripts/validate_translations.py, scripts/voice_dataset_convert.py) and never committed
data/_incoming*/
data/_staged*/
data/_migrated*/
data/voice/

# TTS bake-off run output (audio, manifests, panels)
/runs/

# merge train kill switch (local state, never committed)
scripts/train/PAUSE

# Company voice clones: recordings, consent records and models never go in git
/voices/
**/voices/*/consent.json
**/voices/*/samples/
**/voices/*/forms/
*-clones/
*-clone-tones/
