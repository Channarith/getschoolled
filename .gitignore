*.sqlite
*.db

# ---- Object store / media ----
minio-data/
recordings/

# ---- Auto-generated build manifest (regenerated by scripts/build_release.py /
#      bump_pr_version.py on every bump/build; nothing reads it at runtime -
#      /version uses the VERSION file + AOEP_* env). Tracking it made every PR
#      rewrite the version/sha/time lines, so it hard-conflicted on GitHub's
#      server-side merge (which ignores .gitattributes merge drivers). Untracked
#      = it can never conflict; regenerate locally with
#      `python3 scripts/build_release.py --refresh-only`. ----
build-info.txt

