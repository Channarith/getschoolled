node-linker=hoisted
public-hoist-pattern[]=*
# Copy packages into apps/mobile/node_modules — Metro cannot resolve symlinks that
# escape the project root (e.g. ~/node_modules/.pnpm → blank Android red screen).
package-import-method=copy
# pnpm v11 skips linking node_modules when it thinks install is done (Mac no-op bug).
optimistic-repeat-install=false

# Disable pnpm v10+'s pre-script `pnpm install` check. Three reasons it has to go:
#   1. It triggers ERR_PNPM_IGNORED_BUILDS on esbuild@0.21.5 (a transitive whose
#      binary-selector postinstall is skipped by default) and refuses to run the
#      script — but scripts/mobile-build-release-android.sh and
#      scripts/mobile-xcodebuild-release.sh do their OWN dep check via
#      mobile_deps_ensure_installed, so the pnpm check is redundant.
#   2. It re-runs `pnpm install` without honoring the explicit --node-linker=hoisted
#      --public-hoist-pattern='*' --package-import-method=copy flags we need, which
#      silently un-hoists metro-runtime + @react-native/gradle-plugin (the exact
#      bug that caused the recent iOS Metro / Android Gradle crashes).
#   3. pnpm v11 moved pnpm.onlyBuiltDependencies out of package.json's `pnpm` block
#      into pnpm-workspace.yaml ONLY — but creating that file in apps/mobile would
#      re-activate the hoist trap that the home-dir ~/pnpm-workspace.yaml caused.
#      Disabling the pre-check sidesteps the whole chicken-and-egg problem.
verify-deps-before-run=false

# Home-dir ~/pnpm-workspace.yaml used to make `pnpm install` here a no-op.
# apps/mobile/pnpm-workspace.yaml (packages: ["."]) stops that walk-up.
# Do not pass --ignore-workspace: it skips this file, including allowBuilds.
